{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animation-studio.local/schemas/edit.schema.json",
  "title": "Film edit",
  "description": "films/<film>/edit/edit.json: the film as an ordered list of clips (finished shot videos and title cards) with the joins between them. Engine-neutral (D-030): code builds the MLT project edit/film.mlt from it and computes every duration; the spec only says what goes where.",
  "type": "object",
  "required": ["schema_version", "fps", "width", "height", "clips"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "fps": { "type": "integer", "enum": [24, 25, 30] },
    "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
    "height": { "type": "integer", "minimum": 180, "maximum": 2160 },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["kind", "file", "duration_s"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["shot", "act", "title"] },
          "act": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "description": "The act id (kind act): a whole rendered act as one clip of the movie." },
          "shot": { "type": "string", "pattern": "^s[0-9]{2}_sh[0-9]{2}$", "description": "The shot id (kind shot)." },
          "text": { "type": "string", "minLength": 1, "maxLength": 120, "description": "The card's text (kind title)." },
          "subtitle": { "type": "string", "maxLength": 160 },
          "file": { "type": "string", "description": "The clip's video, relative to the film folder." },
          "duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "transition_in": {
            "type": "object",
            "description": "How this clip joins the one before it (ignored for the first clip). A crossfade overlaps the two by duration_s.",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["cut", "crossfade"] },
              "duration_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 }
            }
          }
        }
      }
    }
  }
}
